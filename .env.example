# Razorpay API Credentials (Test Mode)
RAZORPAY_KEY_ID=rzp_test_TWcM6wNXkUaBlu
RAZORPAY_KEY_SECRET=your_test_secret_here
PORT=3000

# ══════════════════════════════════════════════════════════════════════════
# Payvault Persistence & Cache Architecture
# ══════════════════════════════════════════════════════════════════════════

# PostgreSQL: Permanent Source of Truth (Payments, Orders, Settlements, Investigations)
# All monetary fields are strictly stored as integer paise (BIGINT).
DATABASE_URL=postgresql://payvault:payvault_dev_secret@localhost:5432/payvault

# Redis: Fast Transient State (Chat Conversation Context & Cache)
# Uses scoped keys: payvault:chat:<investigationId>:<conversationId>
REDIS_URL=redis://localhost:6379
CHAT_CONTEXT_TTL_SECONDS=3600

# Payvault Native Intelligence Thresholds
AI_DIFFICULTY_THRESHOLD=50
AI_PRIMARY_CONFIDENCE_THRESHOLD=0.75
